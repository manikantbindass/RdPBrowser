# Production template: replace secrets and addresses before deployment.
# The API source filter is not an OS kill switch or network traffic proxy.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://remoteshield:REPLACE_PASSWORD@database.example.internal:5432/remoteshield_db
DB_SSL_MODE=verify-full
DB_SSL_CA_FILE=/run/secrets/postgres-ca.pem
DB_NETWORK_TRUSTED=false
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_HEX_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_64_RANDOM_HEX_CHARACTERS
VPN_REQUIRED=true
VPN_SUBNET=10.8.0.0/24
SERVER_PUBLIC_IP=203.0.113.10
TRUST_PROXY_CIDRS=172.20.0.10/32
CORS_ORIGINS=https://remoteshield.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
DEVICE_BINDING_ENABLED=true
SSH_ENABLED=false
ANOMALY_DETECTION_ENABLED=false
LOG_LEVEL=info
