# Local-only backend template. Prefer: node scripts/setup-dev.mjs
# Replace placeholders with distinct random values; config:check rejects them.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://remoteshield:REPLACE_PASSWORD@127.0.0.1:5432/remoteshield_db
DB_SSL_MODE=disable
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_HEX_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_64_RANDOM_HEX_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
VPN_REQUIRED=false
VPN_SUBNET=10.8.0.0/24
SERVER_PUBLIC_IP=127.0.0.1
DEVICE_BINDING_ENABLED=false
ANOMALY_DETECTION_ENABLED=false
SSH_ENABLED=false
GEO_RESTRICTION_ENABLED=false
ALLOWED_COUNTRIES=IN,US,GB
LOG_LEVEL=info
# Comma-separated exact origins, without paths. No wildcard or substring matching.
CORS_ORIGINS=http://127.0.0.1:8180,http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
TRUST_PROXY_CIDRS=
