[Unit]
Description=RemoteShield X persistent client traffic restrictions
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target remoteshield-client.service shutdown.target
After=local-fs.target nftables.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/remoteshield/client.env
ExecStart=/bin/bash /opt/remoteshield/vpn-server/firewall/apply.sh client ${ENDPOINT_IPV4}

[Install]
WantedBy=multi-user.target
