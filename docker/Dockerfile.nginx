FROM nginx:1.30.7-alpine-slim@sha256:8c950211a641ec5b23f265450517001f6bcca533666120ebe36cb4cff3d00a55
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx-runtime.conf /etc/nginx/nginx.conf
COPY --chmod=755 docker/19-runtime-directories.sh /docker-entrypoint.d/19-runtime-directories.sh
COPY nginx/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY admin-dashboard/index.html admin-dashboard/styles.css admin-dashboard/app.js admin-dashboard/api.js admin-dashboard/components.js admin-dashboard/views.js admin-dashboard/governance.js /var/www/remoteshield/admin-dashboard/
ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp/conf.d
USER 101:101
EXPOSE 8080 8443
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -qO- http://127.0.0.1:8080/health || exit 1
