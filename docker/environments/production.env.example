NODE_ENV=production
DEPLOYMENT_ENV=production
DOMAIN=control.example.com
CORS_ORIGINS=https://control.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
CONTROL_BIND_IPV4=10.8.0.1
VPN_REQUIRED=true
VPN_SUBNETS=10.8.0.0/24,fd42:5253:5800::/64
VPN_SOURCE_MODE=tunnel
DB_SSL_MODE=disable
DB_NETWORK_TRUSTED=true
DB_POOL_MAX=20
REGISTRATION_ENABLED=false
DEVICE_BINDING_ENABLED=true
AUTH_RATE_LIMIT_MAX=20
DEPLOYMENT_DIRECTORY=/opt/remoteshield-production
OPERATIONS_PORT=9091
ANOMALY_DETECTION_ENABLED=false
SCIM_ENABLED=false
TRACE_SAMPLE_RATE=0.1
BACKUP_MAX_AGE_SECONDS=90000
