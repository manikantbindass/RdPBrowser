# Production Compose template; use setup-dev.mjs for local development.
NODE_ENV=production
DB_PASS=CHANGE_ME_USE_RANDOM_HEX
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_HEX_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_64_RANDOM_HEX_CHARACTERS
VPN_REQUIRED=true
# Explicit trust decision for the private Compose DB network (no DB host port).
DB_SSL_MODE=disable
DB_NETWORK_TRUSTED=true
DOMAIN=remoteshield.example.com
# Used only by compose.dev.yml; include the same origin in CORS_ORIGINS.
DEV_ADMIN_PORT=8180
SERVER_PUBLIC_IP=203.0.113.10
CORS_ORIGINS=https://remoteshield.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
DEVICE_BINDING_ENABLED=true
SSH_ENABLED=false
ANOMALY_DETECTION_ENABLED=false
