FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS dependencies
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci --omit=dev

FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202
RUN addgroup -g 1001 -S remoteshield && adduser -u 1001 -S remoteshield -G remoteshield
WORKDIR /app/backend
COPY --from=dependencies /app/backend/node_modules ./node_modules
COPY backend/package.json ./
COPY backend/src ./src
COPY contracts /app/contracts
COPY security /app/security
USER remoteshield
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=4s --start-period=10s --retries=6 CMD node src/healthcheck.js
CMD ["node", "src/index.js"]
