FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS dependencies
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN apk add --no-cache libstdc++ libatomic \
    && addgroup -g 1001 -S remoteshield && adduser -u 1001 -S remoteshield -G remoteshield
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/docker-entrypoint.sh /usr/local/bin/
RUN node --version
WORKDIR /app/backend
COPY --from=dependencies /app/backend/node_modules ./node_modules
COPY backend/package.json ./
COPY backend/src ./src
COPY contracts /app/contracts
COPY security /app/security
USER remoteshield
ENTRYPOINT ["docker-entrypoint.sh"]
ARG APP_REVISION=development
ENV APP_REVISION=$APP_REVISION
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=4s --start-period=10s --retries=6 CMD node src/healthcheck.js
CMD ["node", "src/index.js"]
