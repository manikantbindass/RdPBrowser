# Container control-plane TLS edge. WireGuard/OS enforce application traffic routing.
upstream control_api { server backend:3000; }
server {
    listen 80;
    server_name ${DOMAIN};
    location = /health { proxy_pass http://control_api; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${DOMAIN};
    server_tokens off;
    ssl_certificate /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 10.8.0.0/24;
    allow 127.0.0.1;
    deny all;
    client_max_body_size 10k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' wss:; img-src 'self' data:; frame-ancestors 'none'" always;
    location /api/ {
        proxy_pass http://control_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /socket.io/ {
        proxy_pass http://control_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /health { proxy_pass http://control_api; }
    location = /ready { proxy_pass http://control_api; }
    location = /admin { return 301 /admin/; }
    location /admin/ { alias /var/www/remoteshield/admin-dashboard/; index index.html; }
    location / { return 404; }
}
