# Container control-plane TLS edge. WireGuard/OS enforce application traffic routing.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 2s;
upstream control_api { zone control_api 64k; server backend:3000 resolve; }
log_format rsx_control '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 8080;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log rsx_control;
    location = /health { return 204; }
    location / { return 301 https://${DOMAIN}$request_uri; }
}
server {
    listen 8443 ssl;
    server_name ${DOMAIN};
    server_tokens off;
    access_log /var/log/nginx/access.log rsx_control;
    ssl_certificate /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;
    proxy_connect_timeout 3s;
    proxy_read_timeout 75s;
    proxy_send_timeout 15s;
    allow 10.8.0.0/24;
    deny all;
    client_max_body_size 10k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' wss:; img-src 'self' data:; frame-ancestors 'none'" always;
    location /api/ {
        proxy_pass http://control_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ~ ^/api/(v1/)?auth/oidc/ {
        error_log /dev/stderr crit;
        proxy_pass http://control_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /socket.io/ {
        proxy_pass http://control_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /health { proxy_pass http://control_api; }
    location = /ready { proxy_pass http://control_api; }
    location = /admin { return 301 /admin/; }
    location /admin/ { alias /var/www/remoteshield/admin-dashboard/; index index.html; }
    location / { return 404; }
}
