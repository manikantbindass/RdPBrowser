# Replace documentation addresses with your approved networks.
name                    = "remoteshield-production"
region                  = "blr1"
size                    = "s-2vcpu-4gb"
environment             = "production"
ssh_key_fingerprints    = ["REPLACE_WITH_REGISTERED_SSH_KEY_FINGERPRINT"]
admin_public_key        = "ssh-ed25519 REPLACE_WITH_PUBLIC_KEY operator"
admin_cidrs             = ["203.0.113.10/32"]
vpn_client_cidrs        = ["198.51.100.0/24", "2001:db8:10::/48"]
web_egress_cidrs        = ["192.0.2.0/25", "2001:db8:20::/48"]
resolver_egress_cidrs   = ["192.0.2.53/32", "2001:db8:20::53/128"]
ntp_egress_cidrs        = ["192.0.2.123/32"]
scim_source_cidrs       = []
enable_provider_backups = false
